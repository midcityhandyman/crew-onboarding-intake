# All optional. With nothing set, everything runs offline against the mock destination.

# SQLite file used by the CLI.
CREW_INTAKE_DB=crew_intake.db

# Where the mock destination keeps its pages between CLI runs.
CREW_MOCK_FILE=mock_destination.json

# Set BOTH of these to push to a real HTTP destination instead of the mock.
# PUT {CREW_DEST_URL}/pages/{key} with a bearer token.
CREW_DEST_URL=
CREW_DEST_API_KEY=
